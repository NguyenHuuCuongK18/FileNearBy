<Window x:Class="FileNearBy.Host.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Near By" Width="1080" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#192F38">
            <Grid Margin="16,30,16,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,0,0,32">
                    <TextBlock Text="File Near By" Foreground="White" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="WINDOWS HOST" Foreground="#9DB5BD" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavigationItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="16,20,0,0">
                    <TextBlock Text="Private by choice." Foreground="#E0ECEF" FontWeight="SemiBold" />
                    <TextBlock Text="You decide what to share." Foreground="#9DB5BD" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="36,32,36,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Name}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedSection.Description}" Style="{StaticResource MutedText}" Margin="0,8,16,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E3EDE9" CornerRadius="14" Padding="13,7" VerticalAlignment="Top" Margin="0,7,0,0">
                    <TextBlock Text="Sharing off" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="CONNECTION" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Text="Offline" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock Text="Sharing is off" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="SHARED LOCATIONS" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock Text="Nothing shared" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="PAIRED DEVICE" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Text="None" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock Text="No phone paired" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}" Padding="32,40">
                        <StackPanel>
                            <Border Background="#E9F3EF" CornerRadius="10" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,24">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SelectedSection.EmptyTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedSection.EmptyMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="File Near By · 0.1.0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding Credit}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Grid>
    </Grid>
</Window>
